                <a href="/"
                   class="nav-link">
                    Home
                </a>

                <a href="/about"
                   class="nav-link">
                    About Me
                </a>

                <a href="/projects"
                   class="nav-link">
                    Projects
                </a>

                <a href="/contact"
                   class="nav-link">
                    Contact Me
                </a>

            </nav>

        </div>

    </div>

</header>